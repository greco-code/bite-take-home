# Local Express port.
PORT=4000

# Required runtime connection string. Use Neon's pooled URL in production.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional direct Neon connection string used only by Drizzle Kit migrations.
# Recommended for production migrations; falls back to DATABASE_URL locally.
# DATABASE_MIGRATION_URL=postgresql://user:password@host/database?sslmode=require

# Comma-separated exact browser origins allowed by the API.
WEB_ORIGINS=http://localhost:3000
