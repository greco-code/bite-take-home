{
  "name": "@bite/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "catalog:import": "tsx --env-file-if-exists=.env src/scripts/import-catalog.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@bite/contracts": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "5.2.1",
    "swagger-ui-express": "^5.0.1",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "supertest": "^7.2.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
